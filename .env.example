# CYBER dashboard — copy to .env.local for local development.
# Never commit real values. Only NEXT_PUBLIC_* variables reach the browser.

# --- Discord OAuth2 sign-in (required for login) -----------------------------
# Discord Developer Portal → your application → OAuth2.
DISCORD_CLIENT_ID=your-application-id
DISCORD_CLIENT_SECRET=your-client-secret
# Must exactly match a redirect registered in the Developer Portal.
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
# Encrypts the session cookie. 32+ random characters: openssl rand -base64 32
SESSION_SECRET=replace-with-at-least-32-random-characters

# --- Optional ----------------------------------------------------------------
# Server-only. Lets the dashboard show which of your servers already have the bot.
DISCORD_BOT_TOKEN=
# Permission bitfield for the bot invite link. Default excludes Administrator.
DISCORD_BOT_PERMISSIONS=1099780189206
# Base URL of the CYBER backend API. Unset = demo mode (drafts stay in the browser).
NEXT_PUBLIC_CYBER_API_URL=
# Canonical site URL for Open Graph metadata. Falls back to the Vercel production URL.
NEXT_PUBLIC_SITE_URL=
